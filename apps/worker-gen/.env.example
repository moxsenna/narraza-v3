# Generation worker process (schema: packages/shared/src/env/worker.ts)
NODE_ENV=development
DATABASE_URL_WORKER=postgresql://narraza:narraza@localhost:5434/narraza
# Least-privilege role for the embedded outbox consumer (D11/S6.3): separate
# variable so splitting the process later is a PM2 change, not a code change.
DATABASE_URL_OUTBOX=postgresql://narraza:narraza@localhost:5434/narraza

# AI providers — real keys first used in staging (M7); dev/CI run mock only.
AI_ENABLE_MOCK=true
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# W3.1 lifecycle host: false disables claim/processor work; reclaim and signals still run.
JOB_PROCESSOR_ENABLED=false

# D12 job lifecycle defaults; all numeric values are positive integers.
# JOB_LEASE_SECONDS=60
# JOB_HEARTBEAT_SECONDS=20
# JOB_RECLAIM_SWEEP_SECONDS=30
# JOB_POLL_MS=1000
# JOB_ERROR_BACKOFF_MS=5000
# JOB_SHUTDOWN_DRAIN_MS=30000
# Invariants: heartbeat < lease; error backoff >= poll; drain >= heartbeat interval.
# RETENTION_SWEEP_MINUTES=60
# RETENTION_MAX_AGE_HOURS=24
# Outbox consumer module — runs regardless of JOB_PROCESSOR_ENABLED.
# OUTBOX_POLL_MS=1000
# OUTBOX_IDLE_BACKOFF_MS=5000
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_SHUTDOWN_DRAIN_MS=30000
# Invariants: idle backoff >= poll; lease > one poll interval.
