# Standalone outbox process (schema: packages/shared/src/env/outbox.ts)
# Not deployed in Rilis 1 (D11: outbox consumer runs inside worker-gen).
NODE_ENV=development
DATABASE_URL_OUTBOX=postgresql://narraza:narraza@localhost:5434/narraza
